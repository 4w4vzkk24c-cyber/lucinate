{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#586e75",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "italic": true,
    "color": "#657b83"
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#859900",
    "bold": true
  },
  "h1": {
    "color": "#859900",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#2aa198",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "color": "#859900",
    "bold": true
  },
  "h4": {
    "prefix": "#### ",
    "color": "#2aa198",
    "bold": true
  },
  "h5": {
    "prefix": "##### ",
    "color": "#859900",
    "bold": true
  },
  "h6": {
    "prefix": "###### ",
    "color": "#2aa198",
    "bold": true
  },
  "strikethrough": {
    "crossed_out": true,
    "color": "#d33682"
  },
  "emph": {
    "italic": true,
    "color": "#b58900"
  },
  "strong": {
    "bold": true,
    "color": "#cb4b16"
  },
  "hr": {
    "color": "#073642"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#268bd2",
    "underline": true
  },
  "link_text": {
    "color": "#268bd2"
  },
  "image": {
    "color": "#268bd2",
    "underline": true
  },
  "image_text": {
    "color": "#586e75",
    "format": "Image: {{.text}} → "
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#d33682",
    "background_color": "#073642"
  },
  "code_block": {
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#839496"
      },
      "background": {
        "background_color": "#073642"
      },
      "error": {
        "color": "#dc322f"
      },
      "comment": {
        "color": "#586e75"
      },
      "comment_preproc": {
        "color": "#586e75"
      },
      "keyword": {
        "color": "#2aa198",
        "bold": true
      },
      "keyword_reserved": {
        "color": "#2aa198",
        "bold": true
      },
      "keyword_namespace": {
        "color": "#2aa198",
        "bold": true
      },
      "keyword_type": {
        "color": "#2aa198"
      },
      "operator": {
        "color": "#839496"
      },
      "punctuation": {
        "color": "#839496"
      },
      "name": {
        "color": "#839496"
      },
      "name_attribute": {
        "color": "#2aa198"
      },
      "name_builtin": {
        "color": "#2aa198"
      },
      "name_class": {
        "color": "#2aa198",
        "bold": true
      },
      "name_constant": {
        "color": "#2aa198"
      },
      "name_decorator": {
        "color": "#d33682"
      },
      "name_exception": {
        "color": "#dc322f"
      },
      "name_function": {
        "color": "#268bd2"
      },
      "name_other": {
        "color": "#839496"
      },
      "name_tag": {
        "color": "#2aa198"
      },
      "name_variable": {
        "color": "#2aa198"
      },
      "literal": {
        "color": "#b58900"
      },
      "literal_date": {
        "color": "#b58900"
      },
      "literal_string": {
        "color": "#b58900"
      },
      "literal_string_escape": {
        "color": "#cb4b16"
      },
      "generic_deleted": {
        "color": "#dc322f"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#859900"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#586e75"
      }
    }
  },
  "table": {
    "center_separator": "+",
    "column_separator": "|",
    "row_separator": "-"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
